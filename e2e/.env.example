# Copy this file to .env and provide values locally. Never commit .env.

# Application destination after API authentication.
URL='https://ui.dev-valay.outerbounds.xyz/dashboard'

# Authentication API host.
URL_AUTH='https://auth.anaconda.com'

# Admin automation user used to generate the shared Playwright storage state.
E2E_AUTOMATION_USER_ADMIN_EMAIL=''
E2E_AUTOMATION_USER_ADMIN_PASSWORD=''

# Optional non-admin automation user for additional storage states.
E2E_AUTOMATION_USER_NON_ADMIN_EMAIL=''
E2E_AUTOMATION_USER_NON_ADMIN_PASSWORD=''
